# Copy this file to .env.local for development. Vercel reads the same
# variables from its dashboard env settings — never commit real values.

# Public — bundled into the browser code. Safe to expose, but visible to users.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_MAP_API_KEY=

# Server-only — must match APP_JWT_SECRET on the backend, byte for byte.
# Used by src/middleware.ts (Edge runtime) to verify access-token signatures.
# Without this, the middleware throws on boot in production.
JWT_SECRET=replace-with-the-same-value-as-backend-APP_JWT_SECRET
